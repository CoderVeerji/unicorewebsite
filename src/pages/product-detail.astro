---
import Base from '../layouts/Base.astro';
---
<Base description="Product details from the Unicore Lubricants range, with viscosity grade, main application and standard packaging confirmed on request."
  title="Unicore Lubricants — Product Detail" active="products" bodyClass="bg-page-bg text-body-text font-sans antialiased min-h-screen flex flex-col justify-between">

  <main id="main-content" class="flex-grow pt-[116px]">

    <!-- Breadcrumb Row -->
    <div class="bg-white border-b border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
        <nav class="flex items-center text-xs text-light-text space-x-2">
          <a href="index.html" data-path="home" class="hover:text-heading-black transition-colors">Home</a>
          <span class="">/</span>
          <a href="products.html" data-path="products" class="hover:text-heading-black transition-colors">Products</a>
          <span class="">/</span>
          <a href="products.html#engine-oils" data-path="products-engine-oils" class="hover:text-heading-black transition-colors">Engine Oils</a>
          <span class="">/</span>
          <span class="text-heading-black truncate">[Product name — to be confirmed by Unicore]</span>
        </nav>
      </div>
    </div>

    <!-- Product Hero / Top Block (Two-column) -->
    <section class="bg-white border-b border-hairline py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
          
          <!-- Left Column: Pack Shot Square Frame -->
          <div class="lg:col-span-5">
            <div class="w-full aspect-square bg-product-frame border border-hairline flex items-center justify-center p-6 text-center">
              <span class="text-[13px] italic text-light-text leading-relaxed max-w-[240px]">
                [Photograph: Studio pack shot of 15W-40 container on light ground]
              </span>
            </div>
          </div>

          <!-- Right Column: Product Detail & Specifications -->
          <div class="lg:col-span-7 flex flex-col justify-start">
            <div class="text-[11px] font-semibold text-logo-blue tracking-wider uppercase mb-2">Engine Oils</div>
            <h1 class="font-serif text-3xl sm:text-4xl lg:text-[42px] leading-tight text-heading-black font-normal mb-4">
              [Product name — to be confirmed by Unicore]
            </h1>
            <p class="text-sm text-body-text leading-relaxed mb-8 max-w-2xl">
              Built for commercial fleet trucks, agricultural tractors, and heavy transport engines carrying loads over long highway routes.
            </p>

            <!-- Specification Table -->
            <div class="border-t border-hairline mb-8 text-sm">
              <div class="grid grid-cols-1 sm:grid-cols-3 py-3 border-b border-hairline gap-1">
                <span class="text-light-text font-medium text-xs uppercase tracking-wider">Viscosity grade</span>
                <span class="sm:col-span-2 text-heading-black">[to be confirmed by Unicore]</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 py-3 border-b border-hairline gap-1">
                <span class="text-light-text font-medium text-xs uppercase tracking-wider">Performance level</span>
                <span class="sm:col-span-2 text-heading-black">[to be confirmed by Unicore]</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 py-3 border-b border-hairline gap-1">
                <span class="text-light-text font-medium text-xs uppercase tracking-wider">Base type</span>
                <span class="sm:col-span-2 text-heading-black">[to be confirmed by Unicore]</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 py-3 border-b border-hairline gap-1">
                <span class="text-light-text font-medium text-xs uppercase tracking-wider">Pack sizes</span>
                <span class="sm:col-span-2 text-heading-black">[to be confirmed by Unicore]</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 py-3 border-b border-hairline gap-1">
                <span class="text-light-text font-medium text-xs uppercase tracking-wider">Main application</span>
                <span class="sm:col-span-2 text-heading-black">[to be confirmed by Unicore]</span>
              </div>
            </div>

            <!-- CTAs & Quiet Availability Notice -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-4">
              <a href="contact.html" data-path="contact" class="inline-flex items-center justify-center bg-logo-blue hover:bg-deep-navy text-white px-7 py-3 rounded-[2px] text-xs font-semibold uppercase tracking-wider transition-colors duration-150 border border-logo-blue text-center">
                Enquire about this product
              </a>
              <a href="contact.html" data-path="contact" class="inline-flex items-center justify-center bg-white hover:bg-product-frame text-heading-black px-7 py-3 rounded-[2px] text-xs font-semibold uppercase tracking-wider transition-colors duration-150 border border-structural-line text-center">
                Request data sheet
              </a>
            </div>
            <p class="text-xs text-light-text">
              Direct factory supply in palletized buckets and barrels for registered distributors and transport workshops across India.
            </p>

          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 1: Where to use it -->
    <section class="py-14 lg:py-16 bg-page-bg border-b border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <div class="text-[11px] font-semibold text-logo-blue tracking-wider uppercase mb-1">Applications</div>
          <h2 class="font-serif text-2xl sm:text-3xl text-heading-black font-normal">Where to use it</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border border-hairline bg-white">
          
          <!-- Card 1 -->
          <div class="p-6 sm:p-8 border-b md:border-b-0 md:border-r border-hairline flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-semibold text-light-text tracking-wider uppercase mb-2">01 / Long-haul road freight</div>
              <h3 class="font-serif text-xl text-heading-black mb-3 font-normal">Multi-axle haulage trucks</h3>
              <p class="text-sm text-body-text leading-relaxed">Maintains full oil pressure during long highway runs under intense summer heat. Keeps pistons and ring grooves free of heavy carbon deposits between scheduled oil drains.</p>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="p-6 sm:p-8 border-b md:border-b-0 md:border-r border-hairline flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-semibold text-light-text tracking-wider uppercase mb-2">02 / Agricultural operations</div>
              <h3 class="font-serif text-xl text-heading-black mb-3 font-normal">Farm tractors in field work</h3>
              <p class="text-sm text-body-text leading-relaxed">
                Protects cylinder walls when pulling heavy rotavators and disc harrows through dusty soil. Prevents internal engine wear during seasonal peak harvesting when tractors run all day without shutoff.
              </p>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="p-6 sm:p-8 flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-semibold text-light-text tracking-wider uppercase mb-2">03 / Commercial city transport</div>
              <h3 class="font-serif text-xl text-heading-black mb-3 font-normal">Buses and delivery trucks</h3>
              <p class="text-sm text-body-text leading-relaxed">
                Guards engine bearings through heavy stop-and-go city traffic and extended idling at loading bays. Prevents sludge build-up in crankcases during humid monsoon stop-start driving.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION 2: What it does -->
    <section class="py-14 lg:py-16 bg-white border-b border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <div class="text-[11px] font-semibold text-logo-blue tracking-wider uppercase mb-1">Engine protection</div>
          <h2 class="font-serif text-2xl sm:text-3xl text-heading-black font-normal">What it does</h2>
        </div>

        <div class="border-t border-hairline divide-y divide-hairline">
          
          <!-- Point 01 -->
          <div class="py-6 sm:py-7 grid grid-cols-1 md:grid-cols-12 gap-4 items-baseline">
            <div class="md:col-span-1">
              <span class="font-serif text-3xl text-logo-blue italic leading-none">01</span>
            </div>
            <div class="md:col-span-4">
              <h3 class="font-sans font-semibold text-base text-heading-black">Maintains strong oil film under high load</h3>
            </div>
            <div class="md:col-span-7">
              <p class="text-sm text-body-text leading-relaxed">Stops metal parts from rubbing together when the truck is carrying heavy payloads up steep road climbs.</p>
            </div>
          </div>

          <!-- Point 02 -->
          <div class="py-6 sm:py-7 grid grid-cols-1 md:grid-cols-12 gap-4 items-baseline">
            <div class="md:col-span-1">
              <span class="font-serif text-3xl text-logo-blue italic leading-none">02</span>
            </div>
            <div class="md:col-span-4">
              <h3 class="font-sans font-semibold text-base text-heading-black">Keeps pistons and rings clean</h3>
            </div>
            <div class="md:col-span-7">
              <p class="text-sm text-body-text leading-relaxed">Prevents soot and black sludge from settling inside the oil passages and sticking piston rings in the cylinders.</p>
            </div>
          </div>

          <!-- Point 03 -->
          <div class="py-6 sm:py-7 grid grid-cols-1 md:grid-cols-12 gap-4 items-baseline">
            <div class="md:col-span-1">
              <span class="font-serif text-3xl text-logo-blue italic leading-none">03</span>
            </div>
            <div class="md:col-span-4">
              <h3 class="font-sans font-semibold text-base text-heading-black">Protects bearings from acid and rust</h3>
            </div>
            <div class="md:col-span-7">
              <p class="text-sm text-body-text leading-relaxed">Neutralises harmful combustion acids produced during diesel fuel burning so internal crankshaft bearings do not pit.</p>
            </div>
          </div>

          <!-- Point 04 -->
          <div class="py-6 sm:py-7 grid grid-cols-1 md:grid-cols-12 gap-4 items-baseline">
            <div class="md:col-span-1">
              <span class="font-serif text-3xl text-logo-blue italic leading-none">04</span>
            </div>
            <div class="md:col-span-4">
              <h3 class="font-sans font-semibold text-base text-heading-black">Resists oil thickening and breakdown</h3>
            </div>
            <div class="md:col-span-7">
              <p class="text-sm text-body-text leading-relaxed">Does not evaporate or turn thick and tar-like during high summer temperatures on long commercial highway journeys.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION 3: Related Products -->
    <section class="py-14 lg:py-16 bg-page-bg border-b border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-baseline justify-between mb-8">
          <div>
            <div class="text-[11px] font-semibold text-logo-blue tracking-wider uppercase mb-1">Range</div>
            <h2 class="font-serif text-2xl sm:text-3xl text-heading-black font-normal">Related products</h2>
          </div>
          <a href="products.html" data-path="products" class="text-xs font-semibold text-logo-blue hover:text-deep-navy uppercase tracking-wider transition-colors hidden sm:inline-block">
            View all categories →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          
          <!-- Card 1: Gear Oils -->
          <div class="bg-white border border-hairline p-5 flex flex-col justify-between">
            <div>
              <div class="w-full aspect-square bg-product-frame border border-hairline flex items-center justify-center p-4 mb-4 text-center">
                <span class="text-[13px] italic text-light-text leading-relaxed max-w-[200px]">
                  [Photograph: Pack shot of 85W-140 Differential Oil container]
                </span>
              </div>
              <div class="text-[11px] font-semibold text-light-text uppercase tracking-wider mb-1">Gear Oils</div>
              <h3 class="font-serif text-lg text-heading-black font-normal mb-2">
                [Product name — to be confirmed by Unicore]
              </h3>
              <p class="text-xs text-body-text leading-relaxed mb-4">
                Protects heavy drive axles and gearbox teeth against wear under sudden shock loads and heavy trailer towing.
              </p>
            </div>
            <div class="border-t border-hairline pt-3 mt-2">
              <div class="text-[10px] text-light-text uppercase tracking-wider font-semibold mb-0.5">Standard packaging</div>
              <div class="text-xs text-heading-black mb-3">[to be confirmed by Unicore]</div>
              <a href="products.html#gear-oils" data-path="products-gear-oils" class="inline-flex items-center text-xs font-semibold text-logo-blue hover:text-deep-navy transition-colors">
                View Gear Oils →
              </a>
            </div>
          </div>

          <!-- Card 2: Coolants -->
          <div class="bg-white border border-hairline p-5 flex flex-col justify-between">
            <div>
              <div class="w-full aspect-square bg-product-frame border border-hairline flex items-center justify-center p-4 mb-4 text-center">
                <span class="text-[13px] italic text-light-text leading-relaxed max-w-[200px]">
                  [Photograph: Pack shot of Heavy Duty Radiator Coolant bottle]
                </span>
              </div>
              <div class="text-[11px] font-semibold text-light-text uppercase tracking-wider mb-1">Coolants</div>
              <h3 class="font-serif text-lg text-heading-black font-normal mb-2">
                [Product name — to be confirmed by Unicore]
              </h3>
              <p class="text-xs text-body-text leading-relaxed mb-4">
                Stops engine radiators from boiling over in peak summer heat and protects water jackets and liners from rust.
              </p>
            </div>
            <div class="border-t border-hairline pt-3 mt-2">
              <div class="text-[10px] text-light-text uppercase tracking-wider font-semibold mb-0.5">Standard packaging</div>
              <div class="text-xs text-heading-black mb-3">[to be confirmed by Unicore]</div>
              <a href="products.html#coolants" data-path="products-coolants" class="inline-flex items-center text-xs font-semibold text-logo-blue hover:text-deep-navy transition-colors">
                View Coolants →
              </a>
            </div>
          </div>

          <!-- Card 3: Greases -->
          <div class="bg-white border border-hairline p-5 flex flex-col justify-between">
            <div>
              <div class="w-full aspect-square bg-product-frame border border-hairline flex items-center justify-center p-4 mb-4 text-center">
                <span class="text-[13px] italic text-light-text leading-relaxed max-w-[200px]">
                  [Photograph: Pack shot of Wheel Bearing Grease container]
                </span>
              </div>
              <div class="text-[11px] font-semibold text-light-text uppercase tracking-wider mb-1">Greases</div>
              <h3 class="font-serif text-lg text-heading-black font-normal mb-2">
                [Product name — to be confirmed by Unicore]
              </h3>
              <p class="text-xs text-body-text leading-relaxed mb-4">
                Stays firmly inside wheel hub bearings under high road temperatures and resists water wash-out during wet monsoon hauls.
              </p>
            </div>
            <div class="border-t border-hairline pt-3 mt-2">
              <div class="text-[10px] text-light-text uppercase tracking-wider font-semibold mb-0.5">Standard packaging</div>
              <div class="text-xs text-heading-black mb-3">[to be confirmed by Unicore]</div>
              <a href="products.html#greases" data-path="products-greases" class="inline-flex items-center text-xs font-semibold text-logo-blue hover:text-deep-navy transition-colors">
                View Greases →
              </a>
            </div>
          </div>

        </div>

        <div class="mt-6 text-center sm:hidden">
          <a href="products.html" data-path="products" class="text-xs font-semibold text-logo-blue hover:underline uppercase tracking-wider">
            View all categories →
          </a>
        </div>
      </div>
    </section>

    <!-- Slim Closing Enquiry Strip (White background, NO dark band other than footer) -->
    <section class="bg-white py-8 border-b border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <p class="text-sm font-medium text-heading-black">
            Looking for trade pricing, drum supply or technical batch confirmation for this product?
          </p>
          <a href="contact.html" data-path="contact" class="inline-flex items-center justify-center bg-logo-blue hover:bg-deep-navy text-white px-6 py-2.5 rounded-[2px] text-xs font-semibold uppercase tracking-wider transition-colors duration-150 whitespace-nowrap">
            Contact Trade Sales →
          </a>
        </div>
      </div>
    </section>

  </main>

</Base>
