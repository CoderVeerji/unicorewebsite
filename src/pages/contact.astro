---
import Base from '../layouts/Base.astro';
---
<Base description="Contact the Unicore Lubricants trade desk about drum consignments, trade terms and distribution across India."
  title="Unicore Lubricants — Contact" active="contact" enquiryHref="dealership.html#dealership-application" bodyClass="bg-page-bg text-body-text font-sans antialiased min-h-screen flex flex-col justify-between">

  <main id="main-content" class="flex-grow pt-[116px]"><div class="flex flex-col w-full">
<!-- Breadcrumb Bar -->
<div class="w-full bg-white border-b border-hairline">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-10 flex items-center">
<nav aria-label="Breadcrumb" class="flex items-center space-x-2 text-xs"><a class="text-xs font-medium text-light-text hover:text-heading-black transition-colors" data-path="home" href="index.html">Home</a>
<span class="text-hairline select-none">/</span>
<span class="text-xs font-semibold text-heading-black">Contact</span></nav>
</div>
</div>
<!-- Page Header & Title Block -->
<section class="w-full border-b border-hairline bg-white">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 text-left"><p class="text-xs font-semibold text-logo-blue tracking-wider uppercase mb-3">DIRECT TRADE &amp; FACTORY DESK</p>
<h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-heading-black tracking-tight mb-4 max-w-4xl">
  Speak directly with our trade desk and works office.
</h1>
<p class="font-sans text-base text-body-text max-w-3xl leading-relaxed">
  Whether placing a drum consignment or requesting trade terms, trade buyers and distributors can contact Unicore directly.
</p></div>
</section>
<!-- Two-Column Section: Details & Enquiry Form -->
<section class="w-full bg-page-bg py-12 sm:py-16">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
<!-- Left Column: Hairline Divided Contact Register -->
<div class="lg:col-span-5 flex flex-col space-y-8"><div>
  <span class="text-xs font-semibold text-light-text uppercase tracking-wider block mb-2">Trade Directory</span>
  <h2 class="font-serif text-2xl sm:text-3xl text-heading-black tracking-tight">Commercial Registry</h2>
</div>
<div class="bg-white border border-hairline divide-y divide-hairline">
  <div class="p-5 flex flex-col space-y-1.5">
    <span class="text-xs font-semibold text-light-text uppercase tracking-wider">Phone Number (Trade Desk)</span>
    <span class="text-sm text-heading-black font-medium">[to be confirmed by Unicore]</span>
  </div>
  <div class="p-5 flex flex-col space-y-1.5">
    <span class="text-xs font-semibold text-light-text uppercase tracking-wider">Email Address</span>
    <span class="text-sm text-heading-black font-medium">[to be confirmed by Unicore]</span>
  </div>
  <div class="p-5 flex flex-col space-y-1.5">
    <span class="text-xs font-semibold text-light-text uppercase tracking-wider">Registered Office Address</span>
    <span class="text-sm text-heading-black font-medium">[to be confirmed by Unicore]</span>
  </div>
  <div class="p-5 flex flex-col space-y-1.5">
    <span class="text-xs font-semibold text-light-text uppercase tracking-wider">Plant &amp; Works Address</span>
    <span class="text-sm text-heading-black font-medium">[to be confirmed by Unicore]</span>
  </div>
  <div class="p-5 flex flex-col space-y-1.5">
    <span class="text-xs font-semibold text-light-text uppercase tracking-wider">Working Hours</span>
    <span class="text-sm text-heading-black font-medium">[to be confirmed by Unicore]</span>
  </div>
  <div class="p-5 flex flex-col space-y-1.5">
    <span class="text-xs font-semibold text-light-text uppercase tracking-wider">GST Identification Number (GSTIN)</span>
    <span class="text-sm text-heading-black font-medium">[to be confirmed by Unicore]</span>
  </div>
</div></div>
<!-- Right Column: Enquiry Form -->
<div class="lg:col-span-7"><div class="bg-white border border-hairline p-6 sm:p-10">
  <div class="mb-8">
    <h2 class="font-serif text-2xl sm:text-3xl text-heading-black tracking-tight mb-2">Send an enquiry</h2>
    <p class="font-sans text-sm text-body-text">Complete the fields below and our trade sales desk will reply directly.</p>
  </div>
  <form
    name="contact"
    method="POST"
    action="thank-you.html"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    class="space-y-6"
  >
              {/* Netlify Forms: the attributes below are what make this live.
                  `name` is the form's name in the Netlify dashboard, the hidden
                  form-name field is what the POST is matched on, and bot-field
                  is a honeypot a human never sees. The action is relative, so a
                  visitor on /ta/ lands on /ta/thank-you.html. */}
    <input type="hidden" name="form-name" value="contact" />
    <p class="hidden">
      <label>Leave this field empty<input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>
    <div class="flex flex-col space-y-1">
      <label class="text-xs font-semibold text-light-text uppercase tracking-wider" for="full-name">Full Name</label>
      <input class="border-0 border-b border-hairline bg-transparent focus:border-logo-blue focus:ring-0 rounded-none py-3 px-0 font-sans text-sm text-heading-black placeholder-light-text/60" id="full-name" name="full-name" placeholder="Contact person or business representative" required="" type="text">
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="flex flex-col space-y-1">
        <label class="text-xs font-semibold text-light-text uppercase tracking-wider" for="phone-number">Phone Number (Mobile / WhatsApp)</label>
        <input class="border-0 border-b border-hairline bg-transparent focus:border-logo-blue focus:ring-0 rounded-none py-3 px-0 font-sans text-sm text-heading-black placeholder-light-text/60" id="phone-number" name="phone-number" placeholder="10-digit mobile number" required="" type="tel">
      </div>
      <div class="flex flex-col space-y-1">
        <label class="text-xs font-semibold text-light-text uppercase tracking-wider" for="email-address">Email Address</label>
        <input class="border-0 border-b border-hairline bg-transparent focus:border-logo-blue focus:ring-0 rounded-none py-3 px-0 font-sans text-sm text-heading-black placeholder-light-text/60" id="email-address" name="email-address" placeholder="trade@company.in" required="" type="email">
      </div>
    </div>
    <div class="flex flex-col space-y-1">
      <label class="text-xs font-semibold text-light-text uppercase tracking-wider" for="subject">Subject</label>
      <select class="border-0 border-b border-hairline bg-transparent focus:border-logo-blue focus:ring-0 rounded-none py-3 px-0 font-sans text-sm text-heading-black" id="subject" name="subject" required="">
        <option value="General Product Enquiry">General Product Enquiry</option>
        <option value="Trade &amp; Stockist Supply">Trade &amp; Stockist Supply</option>
        <option value="Tyre Sealant Application">Tyre Sealant Application</option>
        <option value="Factory &amp; Plant Consignment">Factory &amp; Plant Consignment</option>
        <option value="Technical Fluid Recommendation">Technical Fluid Recommendation</option>
        <option value="Other">Other</option>
      </select>
    </div>
    <div class="flex flex-col space-y-1">
      <label class="text-xs font-semibold text-light-text uppercase tracking-wider" for="message">Message</label>
      <textarea class="border-0 border-b border-hairline bg-transparent focus:border-logo-blue focus:ring-0 rounded-none py-3 px-0 font-sans text-sm text-heading-black placeholder-light-text/60 resize-none" id="message" name="message" placeholder="Provide consignment requirements, vehicle counts, or product grade details" required="" rows="4"></textarea>
    </div>
    <div class="pt-4">
      <button class="bg-logo-blue hover:bg-deep-navy text-white text-xs font-semibold uppercase tracking-wider py-3.5 px-8 rounded-[2px] transition-colors inline-block" type="submit">
        Submit Enquiry
      </button>
    </div>
  </form>
</div></div>
</div>
</div>
</section>
<!-- Map Placeholder Block -->
<section class="w-full bg-white border-t border-hairline py-12 sm:py-16">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="mb-4">
  <span class="text-xs font-semibold text-light-text uppercase tracking-wider block">Logistics &amp; Dispatch Access</span>
</div>
<div class="w-full border border-hairline bg-product-frame aspect-[21/9] sm:h-80 flex flex-col items-center justify-center text-center p-6">
  <p class="font-sans text-sm text-light-text italic">
    [Map: Plant and works location map showing transport access route]
  </p>
</div>
<div class="mt-4">
  <p class="font-sans text-xs text-light-text">
    Facility road connectivity, freight loading bays, and regional transport routes.
  </p>
</div></div>
</section>
</div></main>

</Base>
