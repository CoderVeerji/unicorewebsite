<script>
  // Scrollspy for the left rail: highlights the category section in view.
  // Re-armed on every astro:page-load; the previous scroll listener is removed first.
  let spyHandler = null;

  function initScrollspy() {
    if (spyHandler) window.removeEventListener('scroll', spyHandler);
    spyHandler = null;

    const sections = document.querySelectorAll('div > section[id]');
    const navLinks = document.querySelectorAll('#catalog-sidebar-nav a');
    if (!sections.length || !navLinks.length) return;

    spyHandler = () => {
      let currentId = '';
      const scrollPos = window.scrollY + 180;

      sections.forEach((section) => {
        const top = section.offsetTop;
        const height = section.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          currentId = section.getAttribute('id');
        }
      });

      if (currentId) {
        navLinks.forEach((link) => {
          const href = link.getAttribute('href').replace('#', '');
          const spanText = link.querySelector('span:first-child');
          const spanNum = link.querySelector('span:last-child');
          if (href === currentId) {
            link.classList.add('text-logo-blue', 'border-logo-blue', 'bg-product-frame');
            link.classList.remove('text-body-text', 'border-transparent');
            if (spanText) spanText.classList.add('text-logo-blue', 'font-semibold');
            if (spanNum) {
              spanNum.classList.remove('text-light-text');
              spanNum.classList.add('text-logo-blue');
            }
          } else {
            link.classList.remove('text-logo-blue', 'border-logo-blue', 'bg-product-frame');
            link.classList.add('text-body-text', 'border-transparent');
            if (spanText) spanText.classList.remove('text-logo-blue', 'font-semibold');
            if (spanNum) {
              spanNum.classList.remove('text-logo-blue');
              spanNum.classList.add('text-light-text');
            }
          }
        });
      }
    };
    window.addEventListener('scroll', spyHandler);
  }

  document.addEventListener('astro:page-load', initScrollspy);
</script>
