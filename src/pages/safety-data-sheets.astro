---
import Base from '../layouts/Base.astro';
---
<Base description="Safety Data Sheets for Unicore Lubricants products, available to trade partners on request."
  title="Unicore Lubricants — Safety Data Sheets" active="" bodyClass="bg-page-bg text-body-text font-sans antialiased min-h-screen flex flex-col justify-between">

  <main id="main-content" class="flex-grow pt-[116px]"><div class="flex flex-col w-full">
<div class="w-full bg-white border-b border-hairline">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-10 flex items-center">
<nav aria-label="Breadcrumb" class="flex items-center space-x-2 text-xs"><a class="text-xs font-medium text-light-text hover:text-heading-black transition-colors" data-path="home" href="index.html">Home</a>
<span class="text-hairline select-none">/</span>
<span class="text-xs font-semibold text-heading-black">Safety Data Sheets</span></nav>
</div>
</div>
<section class="w-full border-b border-hairline bg-white">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 text-left"><p class="text-xs font-semibold text-logo-blue tracking-wider uppercase mb-3">SAFETY &amp; COMPLIANCE</p>
<h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-heading-black tracking-tight mb-4 max-w-4xl">Safety Data Sheets (SDS)</h1>
<p class="font-sans text-base text-body-text max-w-3xl leading-relaxed">Product safety information for trade partners, workshops and plant buyers.</p></div>
</section>
<section class="w-full bg-page-bg py-12 sm:py-16">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="max-w-3xl border border-hairline bg-white p-6 sm:p-8">
<p class="text-[11px] uppercase tracking-wider text-light-text mb-2">Status</p>
<p class="font-serif text-2xl text-heading-black mb-4">[to be confirmed by Unicore]</p>
<p class="text-sm text-body-text leading-relaxed mb-6">The Safety Data Sheets for each product are being prepared. Until they are published here, trade partners can request the sheet for any product from the trade desk.</p>
<a class="inline-flex items-center justify-center bg-heading-black hover:bg-logo-blue text-white px-6 py-3 text-xs font-semibold uppercase tracking-wider transition-colors duration-150 rounded-[2px]" data-path="contact" href="contact.html">Contact the trade desk</a>
</div>
</div>
</section>
</div></main>
</Base>
