</div>
</div>
<!-- Empty Cell Placeholder for Clean Hairline Grid Closure -->
<div class="bg-white p-8 hidden lg:flex flex-col justify-between border-hairline pointer-events-none">
</div>
</div>
</div>
</section>
<!-- SECTION 6: HOW WE MAKE IT -->
<section class="w-full bg-page-bg py-20 border-b border-hairline">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
<!-- Left Side: Editorial & Steps -->
<div class="lg:col-span-7">
<span class="text-xs font-semibold uppercase tracking-widest text-logo-blue block mb-3">Quality &amp; Manufacturing</span>
<h2 class="font-serif text-3xl sm:text-4xl text-heading-black font-normal mb-8">
                Blended, tested, then packed.
