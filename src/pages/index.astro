---
import Base from '../layouts/Base.astro';
import HeroToran from '../components/HeroToran.astro';
import Antigravity from '../components/Antigravity.astro';
---
<Base description="Unicore Lubricants manufactures engine oils, gear oils, coolants and specialty greases for transport fleets, farm machinery and industrial plants across India."
  title="Unicore Lubricants" active="home" htmlClass="scroll-smooth" bodyClass="bg-page-bg font-sans text-body-text antialiased">

  <main id="main-content" class="w-full pt-[116px] bg-page-bg min-h-[calc(100vh-116px)]">
<div class="flex flex-col w-full">
<!-- SECTION 1: HERO SECTION -->
<section class="w-full bg-page-bg border-b border-hairline relative overflow-hidden">
<Antigravity />
<HeroToran />
<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
<!-- Left Column -->
<div class="lg:col-span-8 flex flex-col justify-center pr-0 lg:pr-8">
<div class="inline-flex items-center gap-2 mb-6">
<span class="w-2 h-2 bg-logo-blue"></span>
<span class="font-sans text-xs tracking-widest text-logo-blue uppercase font-semibold">
                  HEAVY DUTY &amp; INDUSTRIAL OILS
                </span>
</div>
<h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-heading-black font-normal leading-tight mb-8">
                Oils and lubricants <span class="hero-accent italic text-logo-blue" data-phrases="built to last|built for heat|built for load">built tough</span> for Indian roads, farms, and factories.
              </h1>
<p class="font-sans text-base sm:text-lg text-body-text leading-relaxed mb-10 max-w-2xl">
                Unicore produces reliable engine oils, transmission fluids, greases, and industrial oils that protect hardworking vehicles and plant equipment. Every product is made to perform under heavy loads, hot operating temperatures, and long working hours.
              </p>
<div class="flex flex-wrap items-center gap-4">
<a class="inline-flex items-center justify-center bg-heading-black hover:bg-logo-blue text-white px-8 py-4 text-xs font-semibold uppercase tracking-wider transition-colors duration-150 rounded-[2px]" data-path="products" href="products.html">
                  See our products
                </a>
<a class="inline-flex items-center justify-center bg-white hover:bg-product-frame text-heading-black hover:text-logo-blue px-8 py-4 text-xs font-semibold uppercase tracking-wider transition-colors duration-150 border border-structural-line rounded-[2px]" data-path="dealership" href="dealership.html">
                  Become a distributor
                </a>
</div>
</div>
<!-- Right Column: Product Frame (No drawn bottle) -->
<div class="lg:col-span-4 flex justify-center">
<div class="w-full max-w-[460px] aspect-square bg-product-frame border border-hairline relative flex flex-col items-center justify-center p-8"><div class="text-center px-4"><p class="font-serif italic text-base sm:text-lg text-heading-black max-w-xs leading-relaxed">[Photograph: Pack shot of Engine Oil container on light ground]</p></div><div class="absolute bottom-0 right-0 left-0 sm:left-auto bg-white border-t sm:border-l border-hairline p-3 sm:max-w-xs"><span class="block text-xs font-semibold tracking-wider text-heading-black uppercase mb-0.5">Engine Oil</span><span class="block text-[11px] text-light-text">Pack sizes: [to be confirmed by Unicore]</span></div></div>
</div>
</div>
</div>
</section>
<!-- SECTION 2: QUIET GRADE STRIP (Viscosity Only) -->
<section class="w-full bg-page-bg border-b border-hairline py-4">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="w-full marquee">
<div class="marquee-track">
<p class="text-xs sm:text-sm text-light-text text-center tracking-[0.2em] uppercase whitespace-nowrap">
              15W-40 <span class="text-structural-line mx-3">·</span>
              20W-40 <span class="text-structural-line mx-3">·</span>
              20W-50 <span class="text-structural-line mx-3">·</span>
              5W-30 <span class="text-structural-line mx-3">·</span>
              EP-90 <span class="text-structural-line mx-3">·</span>
              85W-140 <span class="text-structural-line mx-3">·</span>
              EP-2 <span class="text-structural-line mx-3">·</span>
            </p>
<p class="text-xs sm:text-sm text-light-text text-center tracking-[0.2em] uppercase whitespace-nowrap" aria-hidden="true">
              15W-40 <span class="text-structural-line mx-3">·</span>
              20W-40 <span class="text-structural-line mx-3">·</span>
              20W-50 <span class="text-structural-line mx-3">·</span>
              5W-30 <span class="text-structural-line mx-3">·</span>
              EP-90 <span class="text-structural-line mx-3">·</span>
              85W-140 <span class="text-structural-line mx-3">·</span>
              EP-2 <span class="text-structural-line mx-3">·</span>
            </p>
</div>
</div>
</div>
</section>
<!-- SECTION 3: PRODUCT RANGE (Three-Across Hairline Grid, No drawn bottles) -->
<section class="w-full bg-white py-20 border-b border-hairline">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 pb-6 border-b border-hairline gap-4">
<div><span class="text-xs font-semibold uppercase tracking-widest text-logo-blue block mb-2">Products</span><h2 class="font-serif text-3xl sm:text-4xl text-heading-black font-normal">Product Range</h2></div>
<a class="text-xs font-semibold uppercase tracking-wider text-logo-blue hover:underline inline-flex items-center gap-1" data-path="products" href="products.html">See all products →</a>
</div>
<!-- Hairline Grid Container -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-hairline bg-hairline gap-px">
<!-- 01 Engine Oils -->
<div class="bg-white p-8 flex flex-col justify-between hover:bg-page-bg transition-colors">
<div>
<div class="w-full aspect-[4/3] bg-product-frame border border-hairline relative p-4 mb-6 flex flex-col items-center justify-center text-center"><span class="absolute top-3 left-3 font-serif italic text-2xl text-light-text">01</span><div class="text-center px-4"><p class="font-serif italic text-sm text-body-text max-w-xs leading-relaxed">[Photograph: Pack shot of Unicore Engine Oil container]</p></div></div>
<h3 class="font-serif text-2xl text-heading-black font-normal mb-2">Engine Oils</h3>
<p class="text-sm text-body-text leading-relaxed mb-6">
                  Multi-grade oils that protect engines from heavy wear, heat buildup, and internal deposits.
                </p>
</div>
<div class="pt-4 border-t border-hairline">
<span class="text-[11px] uppercase tracking-wider text-light-text block mb-1">Standard Packaging</span>
<span class="text-xs text-heading-black block font-medium mb-4">[to be confirmed by Unicore]</span>
<a class="text-xs uppercase tracking-wider font-semibold text-logo-blue hover:underline inline-flex items-center gap-1" data-path="products-engine-oils" href="products.html#engine-oils">
                  View product →
                </a>
</div>
</div>
<!-- 02 Gear Oils -->
<div class="bg-white p-8 flex flex-col justify-between hover:bg-page-bg transition-colors">
<div>
<div class="w-full aspect-[4/3] bg-product-frame border border-hairline relative p-4 mb-6 flex flex-col items-center justify-center text-center"><span class="absolute top-3 left-3 font-serif italic text-2xl text-light-text">02</span><div class="text-center px-4"><p class="font-serif italic text-sm text-body-text max-w-xs leading-relaxed">[Photograph: Pack shot of Unicore Gear Oil container]</p></div></div>
<h3 class="font-serif text-2xl text-heading-black font-normal mb-2">Gear Oils</h3>
<p class="text-sm text-body-text leading-relaxed mb-6">
                  Heavy-duty gear oils built to protect transmission gears under sudden shocks and extreme pressures.
                </p>
</div>
<div class="pt-4 border-t border-hairline">
<span class="text-[11px] uppercase tracking-wider text-light-text block mb-1">Standard Packaging</span>
<span class="text-xs text-heading-black block font-medium mb-4">[to be confirmed by Unicore]</span>
<a class="text-xs uppercase tracking-wider font-semibold text-logo-blue hover:underline inline-flex items-center gap-1" data-path="products-gear-oils" href="products.html#gear-oils">
                  View product →
                </a>
</div>
</div>
<!-- 03 Coolants -->
<div class="bg-white p-8 flex flex-col justify-between hover:bg-page-bg transition-colors">
<div>
<div class="w-full aspect-[4/3] bg-product-frame border border-hairline relative p-4 mb-6 flex flex-col items-center justify-center text-center"><span class="absolute top-3 left-3 font-serif italic text-2xl text-light-text">03</span><div class="text-center px-4"><p class="font-serif italic text-sm text-body-text max-w-xs leading-relaxed">[Photograph: Pack shot of Unicore Coolant bottle]</p></div></div>
<h3 class="font-serif text-2xl text-heading-black font-normal mb-2">Coolants</h3>
<p class="text-sm text-body-text leading-relaxed mb-6">
                  Radiator fluids that prevent overheating, boiling, and metal rust inside the cooling passage.
                </p>
</div>
<div class="pt-4 border-t border-hairline">
<span class="text-[11px] uppercase tracking-wider text-light-text block mb-1">Standard Packaging</span>
<span class="text-xs text-heading-black block font-medium mb-4">[to be confirmed by Unicore]</span>
<a class="text-xs uppercase tracking-wider font-semibold text-logo-blue hover:underline inline-flex items-center gap-1" data-path="products-coolants" href="products.html#coolants">
                  View product →
                </a>
</div>
</div>
<!-- 04 Greases -->
<div class="bg-white p-8 flex flex-col justify-between hover:bg-page-bg transition-colors">
<div>
<div class="w-full aspect-[4/3] bg-product-frame border border-hairline relative p-4 mb-6 flex flex-col items-center justify-center text-center"><span class="absolute top-3 left-3 font-serif italic text-2xl text-light-text">04</span><div class="text-center px-4"><p class="font-serif italic text-sm text-body-text max-w-xs leading-relaxed">[Photograph: Pack shot of Unicore Grease tub and barrel]</p></div></div>
<h3 class="font-serif text-2xl text-heading-black font-normal mb-2">Greases</h3>
<p class="text-sm text-body-text leading-relaxed mb-6">
                  Long-lasting lubricating greases that stay in place under high pressure and resist water washout.
                </p>
</div>
<div class="pt-4 border-t border-hairline">
<span class="text-[11px] uppercase tracking-wider text-light-text block mb-1">Standard Packaging</span>
<span class="text-xs text-heading-black block font-medium mb-4">[to be confirmed by Unicore]</span>
<a class="text-xs uppercase tracking-wider font-semibold text-logo-blue hover:underline inline-flex items-center gap-1" data-path="products-greases" href="products.html#greases">
                  View product →
                </a>
</div>
</div>
<!-- 05 Agricultural Oils -->
<div class="bg-white p-8 flex flex-col justify-between hover:bg-page-bg transition-colors">
<div>
<div class="w-full aspect-[4/3] bg-product-frame border border-hairline relative p-4 mb-6 flex flex-col items-center justify-center text-center"><span class="absolute top-3 left-3 font-serif italic text-2xl text-light-text">05</span><div class="text-center px-4"><p class="font-serif italic text-sm text-body-text max-w-xs leading-relaxed">[Photograph: Pack shot of Unicore Tractor Oil can]</p></div></div>
<h3 class="font-serif text-2xl text-heading-black font-normal mb-2">Agricultural Oils</h3>
<p class="text-sm text-body-text leading-relaxed mb-6">
