---
import Base from '../layouts/Base.astro';
import HeroToran from '../components/HeroToran.astro';
import Antigravity from '../components/Antigravity.astro';
import { Picture } from 'astro:assets';
import bottle from '../assets/tyre/bottles.png';
import { bikeSvg } from '../components/k4-bike.mjs';
import k4a from '../assets/kick/kick-20w40.png';
import k4b from '../assets/kick/kick-20w50.png';
import k4c from '../assets/kick/kick-10w30.png';
import k4d from '../assets/kick/kick-15w50.png';
import HeroDrips from '../components/HeroDrips.astro';
import heroLubricants from '../assets/hero/lubricants.png';
import heroAutomotive from '../assets/hero/automotive.png';
import heroCoolants from '../assets/hero/coolants.png';
import heroBrake from '../assets/hero/brake.png';
import heroGrease from '../assets/hero/grease.png';
import heroTyre from '../assets/hero/tyre-sealant.png';

// The word in the highlighted box and the picture beside it change together.
// "Lubricants" is the first state and the only one in the HTML a crawler reads.
const slides = [
  { text: 'Lubricants', short: 'Lubricants', img: heroLubricants, alt: 'Golden lubricant oil pouring from a metal can into a pool' },
  { text: 'Automotive & Industrial Oil', short: 'Auto & Ind.', img: heroAutomotive, alt: 'Automotive and industrial oil pouring into a pool' },
  { text: 'Coolants', short: 'Coolants', img: heroCoolants, alt: 'Green engine coolant pouring from a metal can' },
  { text: 'Shocker & Brake Fluids', short: 'Shocker & Brake', img: heroBrake, alt: 'Orange shock absorber and brake fluid pouring from a metal can' },
  { text: 'High Temp. Grease', short: 'Grease', img: heroGrease, alt: 'Blue high temperature grease flowing from a metal can' },
  { text: 'Tyre Sealant Liquid', short: 'Tyre Sealant', img: heroTyre, alt: 'Unicore TyreProtect tyre sealant bottles in 250 ml and 500 ml' },
];
const heroFeatures = [
  { label: ['Engine', 'Protection'], icon: '<path d="M4 10h2l2-3h5l2 3h3v6h-2l-1 2H9l-2-2H4z"/><path d="M2 12v4M22 12v4M10 7V5h4v2"/>' },
  { label: ['Reduced', 'Friction'], icon: '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1"/><circle cx="12" cy="12" r="6.6"/>' },
  { label: ['Heat', 'Control'], icon: '<path d="M10 4a2 2 0 0 1 4 0v9.3a4 4 0 1 1-4 0z"/><path d="M12 9v6"/><circle cx="12" cy="17.2" r="1.3"/>' },
  { label: ['Extended', 'Equipment Life'], icon: '<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8-7.5 9.5-4.3-1.5-7.5-4.9-7.5-9.5V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>' },
];

// Logos in /public/logos: Tata, Mahindra, Honda, Hyundai, Toyota, Kia, JCB,
// John Deere, Volvo, Scania from the Simple Icons set; Hero, Bajaj, Royal
// Enfield, Maruti Suzuki from Wikimedia Commons. They are registered
// trademarks of their owners: confirm with Unicore which makes they may show.
// Still to add when the files are supplied: Ashok Leyland, Eicher, TVS,
// Swaraj, Sonalika, BharatBenz.
const products = [
  { name: 'Engine Oils', text: 'Multi-grade oils that protect engines from heavy wear, heat buildup, and internal deposits.', path: 'products-engine-oils', href: 'products.html#engine-oils',
    icon: '<path d="M32 7C32 7 14 28 14 40a18 18 0 0 0 36 0C50 28 32 7 32 7Z"/><path d="M23 42a9 9 0 0 0 7 8"/>' },
  { name: 'Gear Oils', text: 'Heavy-duty gear oils built to protect transmission gears under sudden shocks and extreme pressures.', path: 'products-gear-oils', href: 'products.html#gear-oils',
    icon: '<circle cx="32" cy="32" r="9"/><circle cx="32" cy="32" r="19" stroke-width="5" stroke-dasharray="6.4 5.2" stroke-linecap="butt"/><circle cx="32" cy="32" r="15"/>' },
  { name: 'Coolants', text: 'Radiator fluids that prevent overheating, boiling, and metal rust inside the cooling passage.', path: 'products-coolants', href: 'products.html#coolants',
    icon: '<path d="M32 8v48M11 20l42 24M11 44l42-24"/><path d="M27 12l5 5 5-5M27 52l5-5 5 5M10 27l7 1-1 7M54 37l-7-1 1-7"/>' },
  { name: 'Greases', text: 'Long-lasting lubricating greases that stay in place under high pressure and resist water washout.', path: 'products-greases', href: 'products.html#greases',
    icon: '<ellipse cx="32" cy="22" rx="19" ry="7"/><path d="M13 22v22c0 3.9 8.5 7 19 7s19-3.1 19-7V22"/><path d="M13 33c0 3.9 8.5 7 19 7s19-3.1 19-7"/>' },
  { name: 'Agricultural Oils', text: 'All-round farm oils protecting tractor engines, wet brakes, and hydraulic lift arms.', path: 'products-agricultural-oils', href: 'products.html#agricultural-oils',
    icon: '<path d="M32 58V20"/><path d="M32 20c-5-3-5-9 0-13 5 4 5 10 0 13Z"/><path d="M32 32c-8 0-12-5-12-10 7 0 12 3 12 10ZM32 32c8 0 12-5 12-10-7 0-12 3-12 10ZM32 46c-8 0-12-5-12-10 7 0 12 3 12 10ZM32 46c8 0 12-5 12-10-7 0-12 3-12 10Z"/>' },
  { name: 'Hydraulic Oils', text: 'Industrial fluids that keep hydraulic pumps and factory machinery operating smoothly without power loss.', path: 'products-industrial-hydraulic-oils', href: 'products.html#industrial-hydraulic-oils',
    icon: '<rect x="6" y="22" width="30" height="20" rx="2"/><path d="M36 32h22M58 24v16M14 22v-6M28 22v-6M14 42v6M28 42v6"/><path d="M12 32h18"/>' },
];
const apps = [
  { tab: 'Two-Wheelers', tag: '01 / Mobility', title: 'Two-Wheelers', text: 'Smooth clutch grip and engine protection for high-mileage motorcycles and automatic scooters.', runs: ['Motorcycles', 'Automatic scooters'], img: heroLubricants, theme: 'gold' },
  { tab: 'Commercial Fleets', tag: '02 / Logistics', title: 'Commercial Fleets', text: 'Durable lubricants engineered for long-haul trucks and bus fleets running continuous routes.', runs: ['Long-haul trucks', 'Bus fleets'], img: heroGrease, theme: 'blue' },
  { tab: 'Agricultural Machinery', tag: '03 / Agronomy', title: 'Agricultural Machinery', text: 'Reliable protection for tractors, pumps, and harvesters operating in muddy and dusty soil.', runs: ['Tractors', 'Pumps', 'Harvesters'], img: heroCoolants, theme: 'green' },
  { tab: 'Off-Highway Equipment', tag: '04 / Earthmoving', title: 'Off-Highway Equipment', text: 'Heavy hydraulic oils and greases designed for excavators, cranes, and quarry machinery.', runs: ['Excavators', 'Cranes', 'Quarry machinery'], img: heroBrake, theme: 'orange' },
  { tab: 'Industrial Plants', tag: '05 / Manufacturing', title: 'Industrial Plants', text: 'Continuous protection for factory power presses, gear units, and manufacturing assembly lines.', runs: ['Power presses', 'Gear units', 'Assembly lines'], img: heroAutomotive, theme: 'steel' },
];
// KICK-4T grades. 20W40 is the client's real pack photo; the other three are
// that photo with the grade on the label re-set, until real pack photos arrive.
const k4 = [
  { grade: '20W40', img: k4a, real: true },
  { grade: '20W50', img: k4b },
  { grade: '10W30', img: k4c },
  { grade: '15W50', img: k4d },
];
const brands = [
  { name: 'Tata', file: 'tata', h: 30 },
  { name: 'Mahindra', file: 'mahindra', h: 15 },
  { name: 'Maruti Suzuki', file: 'maruti', h: 28 },
  { name: 'Hero', file: 'hero', h: 26 },
  { name: 'Bajaj', file: 'bajaj', h: 22 },
  { name: 'Royal Enfield', file: 'royalenfield', h: 32 },
  { name: 'Honda', file: 'honda', h: 30 },
  { name: 'Hyundai', file: 'hyundai', h: 22 },
  { name: 'Toyota', file: 'toyota', h: 30 },
  { name: 'JCB', file: 'jcb', h: 20 },
  { name: 'John Deere', file: 'johndeere', h: 38 },
  { name: 'Volvo', file: 'volvo', h: 34 },
  { name: 'Scania', file: 'scania', h: 38 },
  { name: 'Kia', file: 'kia', h: 18 },
];
---
<Base description="Unicore Lubricants manufactures engine oils, gear oils, coolants and specialty greases for transport fleets, farm machinery and industrial plants across India."
  title="Unicore Lubricants" active="home" htmlClass="scroll-smooth" bodyClass="bg-page-bg font-sans text-body-text antialiased">

  <main id="main-content" class="w-full pt-[116px] bg-page-bg min-h-[calc(100vh-116px)] scenes-root">
<div class="flex flex-col w-full">
<nav class="scene-dots" aria-label="Sections of this page" data-scene-dots></nav>
<!-- SCENE 1: HOME = hero + brand strip, one full screen -->
<div class="scene scene-home" data-scene="Home" id="home-scene">
<!-- SECTION 1: HERO SECTION -->
<section class="w-full bg-page-bg border-b border-hairline relative overflow-hidden scene-home-hero">
<Antigravity mobile fade="46%" />
<HeroToran />
<HeroDrips />
<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
<!-- Left Column -->
<div class="hero-left lg:col-span-7 flex flex-col justify-center pr-0 lg:pr-6">
<div class="hero-eyebrow inline-flex items-center gap-2 mb-5">
<span class="w-2 h-2 bg-deep-navy"></span>
<span class="font-sans text-xs sm:text-sm tracking-[0.18em] text-deep-navy uppercase font-bold">Premium Lubricants</span>
</div>
<h1 class="hero-h1 font-serif text-heading-black" data-hero-rotator data-phrases={JSON.stringify(slides.slice(1).map((x) => x.text))}>
<span class="hero-l1">High-performance</span>
<span class="hl-box" data-hl-box>
<span class="hl-first">{slides[0].text}</span>
</span>
<span class="hero-l3">for a smoother, longer life</span>
</h1>
<ul class="hero-feats" aria-label="Benefits">
{heroFeatures.map((f) => (
<li class="hero-feat">
<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
<span>{f.label[0]}<br />{f.label[1]}</span>
</li>
))}
</ul>
<div class="hero-actions flex flex-wrap items-center gap-3 sm:gap-4">
<a class="hero-btn hero-btn-primary" data-path="products" href="products.html">Explore our lubricants <span aria-hidden="true">→</span></a>
<a class="hero-btn hero-btn-ghost" data-path="dealership" href="dealership.html">Become a distributor</a>
</div>
</div>
<!-- Right Column: the picture changes with the word in the headline -->
<div class="hero-right lg:col-span-5 flex justify-center">
<div class="hero-stage" data-hero-stage>
<span class="hero-rings" aria-hidden="true"></span>
<div class="hero-visual" data-hero-visual>
{slides.map((sl, i) => (
<Picture class:list={['hero-slide', i === 0 && 'is-on']} src={sl.img} formats={['webp']} widths={[480, 720]} sizes="(min-width: 1024px) 460px, 90vw" alt={sl.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
))}
</div>
<div class="hero-cap" aria-live="polite"><small>Currently viewing</small><span data-hero-cap>{slides[0].text}</span></div>
<div class="hero-index" aria-hidden="true"><strong data-hero-index>01</strong> / {String(slides.length).padStart(2, '0')}</div>
<div class="hero-pills" role="group" aria-label="Choose a product range">
{slides.map((sl, i) => (
<button type="button" class:list={['hero-pill', i === 0 && 'is-on']} data-hero-pill={i} aria-pressed={i === 0 ? 'true' : 'false'}>{sl.short}</button>
))}
</div>
</div>
</div>
</div>
</div>
</section>
<!-- SECTION 2: VEHICLE & MACHINERY BRAND STRIP -->
<section class="w-full bg-page-bg border-b border-hairline py-7 scene-home-strip">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<p class="text-center text-[11px] font-semibold uppercase tracking-[0.3em] text-light-text mb-5">Built for the machines India runs on</p>
<div class="w-full marquee brand-marquee">
{[0, 1].map((copy) => (
<ul class="marquee-track-row" aria-hidden={copy === 1 ? 'true' : undefined}>
{[...brands, ...brands, ...brands].map((b) => (
<li class="brand-item">
<img class="brand-logo" src={`/logos/${b.file}.svg`} alt={b.name} height={b.h} style={`height:${b.h}px`} loading="eager" decoding="async" draggable="false" />
</li>
))}
</ul>
))}
</div>
</div>
</section>
</div>
<!-- SECTION 3: PRODUCT RANGE (Three-Across Hairline Grid, No drawn bottles) -->
<section class="scene scene-products w-full bg-white border-b border-hairline" data-scene="Products" data-pin data-no-motion>
<div class="ps-sticky">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
<div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 pb-4 border-b border-hairline gap-4" data-r="up">
<div><span class="text-xs font-semibold uppercase tracking-widest text-logo-blue block mb-2">Products</span><h2 class="font-serif text-3xl sm:text-4xl text-heading-black font-normal">Product Range</h2></div>
<a class="seeall" data-path="products" href="products.html"><span>See all products</span><svg class="seeall-ic" width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true"><circle cx="17" cy="17" r="16" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 17h12M18 11.5 23.5 17 18 22.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
</div>
<!-- Product carousel: scroll-snap track, prev/next, progress bar -->
<div class="pc" data-carousel data-no-motion>
<div class="pc-track" data-carousel-track tabindex="0" aria-label="Product range, scroll sideways">
{products.map((pr, i) => (
<article class="pc-card" style={`--i:${i}`}>
<a class="pc-link" data-path={pr.path} href={pr.href}><span class="sr-only">{pr.name}: view product</span></a>
<div class="pc-media">
<span class="pc-num">{String(i + 1).padStart(2, '0')}</span>
<svg class="pc-icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pr.icon} />
<span class="pc-rings" aria-hidden="true"></span>
</div>
<h3 class="font-serif text-3xl text-heading-black font-normal mb-3">{pr.name}</h3>
<p class="text-sm text-body-text leading-relaxed mb-6">{pr.text}</p>
<div class="pc-foot">
<span class="text-[11px] uppercase tracking-wider text-light-text block mb-1">Standard Packaging</span>
<span class="text-xs text-heading-black block font-medium mb-4">[to be confirmed by Unicore]</span>
<span class="pc-cta text-xs uppercase tracking-wider font-semibold text-logo-blue inline-flex items-center gap-1">View product <span class="pc-arrow" aria-hidden="true">→</span></span>
</div>
</article>
))}
</div>
<div class="pc-controls">
<div class="pc-progress" aria-hidden="true"><span class="pc-progress-bar" data-carousel-bar></span></div>
<div class="flex items-center gap-2">
<button type="button" class="pc-btn" data-carousel-prev aria-label="Previous products">←</button>
<button type="button" class="pc-btn" data-carousel-next aria-label="Next products">→</button>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- SCENE: KICK-4T BIKE ENGINE OILS (pinned: scrolling rides the bike and changes the grade) -->
<section class="scene scene-4t" data-scene="Bike Engine Oils" data-no-motion data-k4 id="bike-engine-oils">
<h2 class="sr-only">Our bike engine oil segment: Unicore KICK-4T in 20W40, 20W50, 10W30 and 15W50</h2>
<div class="k4-sticky">
<div class="k4-intro" aria-hidden="true">
<span class="k4-intro-eyebrow">Unicore Lubricants</span>
<span class="k4-intro-title">Our Bike<br />Engine Oil <em>Segment</em></span>
<span class="k4-intro-sub">KICK-4T &middot; 4-stroke motorcycle engine oils</span>
<span class="k4-scroll"><i></i>Scroll</span>
</div>
<div class="k4-stage max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
<div class="k4-copy">
<div class="k4-eyebrow"><span></span>Premium 4-stroke engine oils</div>
<p class="k4-h" aria-hidden="true">Power every<br />ride. <span class="k4-hl">KICK-4T</span></p>
<p class="k4-lead">High-performance engine oil for 4-stroke motorcycles. Built to support smooth rides and dependable engine lubrication on everyday roads.</p>
<ul class="k4-points">
{[
  ['Engine protection', '<path d="M4 6h10l4 4v8H4zM2 11h2m14 2h3M7 6V3h7"/><path d="M8 13h6"/>'],
  ['Smooth performance', '<path d="M12 2v20M7 7a7 7 0 1 0 10 0M6 15h12"/>'],
  ['4-stroke formulation', '<path d="m12 2 8 4v6c0 5-3.5 8.1-8 10-4.5-1.9-8-5-8-10V6z"/><path d="m8 12 3 3 5-6"/>'],
  ['Everyday riding', '<path d="M9 3h6m-3 0v13M8 9c-2 3-4 6-4 8a8 8 0 0 0 16 0c0-2-2-5-4-8"/>'],
].map(([t, p]) => <li><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p} /><span>{t}</span></li>)}
</ul>
<div class="k4-grades" role="group" aria-label="Choose a viscosity grade">
{k4.map((g, i) => <button type="button" class:list={['k4-grade', i === 0 && 'is-on']} data-k4-grade={i} aria-pressed={i === 0 ? 'true' : 'false'}>{g.grade}</button>)}
</div>
<a class="k4-cta" data-path="products-engine-oils" href="products.html#engine-oils">Explore 4T oils <span aria-hidden="true">→</span></a>
</div>
<div class="k4-visual" data-k4-visual>
<span class="k4-rings" aria-hidden="true"></span>
<span class="k4-burst" data-k4-burst aria-hidden="true"><b></b><i></i><i></i><i></i><u style="--a:0deg"></u><u style="--a:60deg"></u><u style="--a:120deg"></u><u style="--a:180deg"></u><u style="--a:240deg"></u><u style="--a:300deg"></u></span>
<div class="k4-cap" aria-live="polite"><small>Currently viewing</small><span data-k4-cap>KICK-4T 20W40</span></div>
<div class="k4-bottles">
{k4.map((g, i) => (
<Picture class:list={['k4-bottle', i === 0 && 'is-on']} src={g.img} formats={['webp']} widths={[320, 600]} sizes="(min-width: 1024px) 300px, 50vw" alt={`Unicore KICK-4T ${g.grade} 4-stroke engine oil, 900 ml bottle`} loading={i === 0 ? 'eager' : 'lazy'} />
))}
</div>
<div class="k4-index" aria-hidden="true"><strong data-k4-index>01</strong> / 04</div>
</div>
</div>
<div class="k4-road" aria-hidden="true">
<div class="k4-lane"><span class="k4-dash" data-k4-dash></span></div>
<div class="k4-rider" data-k4-rider>
<span class="k4-shadow"></span>
<span class="k4-flip" data-k4-flip set:html={bikeSvg("r")}></span>
</div>
</div>
</div>
<p class="k4-note">Grade labels on 10W30, 15W50 and 20W50 are illustrative until the pack photographs are supplied. Always follow your vehicle manufacturer's recommended viscosity and oil specification.</p>
</section>
<!-- SCENE: TYRE SEALANT GEL (client banner: white, green, two bottles) -->
<section class="scene scene-tyre" data-scene="Tyre Sealant" data-no-motion>
<div class="tyre-bg" aria-hidden="true"><span class="tyre-ring tyre-ring-1"></span><span class="tyre-ring tyre-ring-2"></span><span class="tyre-ring tyre-ring-3"></span></div>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
<div class="lg:col-span-7 order-2 lg:order-1">
<span class="tyre-eyebrow" data-r="up"><span class="tyre-dot"></span>Specialty Products</span>
<h2 class="tyre-h2 font-serif" data-r="up" style="--d:120ms">Tyre Sealant Gel <span class="tyre-accent">for tubeless tyres</span></h2>
<p class="tyre-lead" data-r="up" style="--d:240ms">Heavy-duty tyre sealant gel that helps seal punctures, reduce slow leaks, and keep vehicles moving longer on roads and worksites.</p>
<div data-r="up" style="--d:300ms"><ul class="tyre-feats"><li style="--d:0ms"><svg class="tyre-tick" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 8.8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Prevents and repairs flat tyres</span></li><li style="--d:70ms"><svg class="tyre-tick" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 8.8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Seals instantly</span></li><li style="--d:140ms"><svg class="tyre-tick" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 8.8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Stops slow leaks</span></li><li style="--d:210ms"><svg class="tyre-tick" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 8.8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Safe and easy to use</span></li><li style="--d:280ms"><svg class="tyre-tick" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 8.8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Environmentally friendly</span></li><li style="--d:350ms"><svg class="tyre-tick" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 8.8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Available in 250ml &amp; 500ml</span></li></ul></div>
<div data-r="up" style="--d:520ms"><a class="tyre-cta" data-path="tyre-sealant" href="tyre-sealant.html">Explore Tyre Sealant Gel <span aria-hidden="true">→</span></a></div>
</div>
