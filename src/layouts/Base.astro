---
/**
 * Base layout: html shell, fonts, global styles, view transitions, and the
 * shared header / mobile drawer / footer. Every page in src/pages renders
 * its <main> inside this layout.
 *
 * Props
 *   title        <title> text
 *   active       highlighted nav item (see Header.astro)
 *   enquiryHref  target of the "Enquiry Now" buttons (default contact.html)
 *   htmlClass    extra class on <html>
 *   bodyClass    class on <body>
 *
 * Slots
 *   (default)    the page <main>
 *   head         extra <head> content (page-specific styles)
 */
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import Footer from '../components/Footer.astro';
import AnnouncementStrip from '../components/AnnouncementStrip.astro';
import CurtainReveal from '../components/CurtainReveal.astro';
import { STORAGE_KEY, isAnnouncementActive } from '../config/announcement.js';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/cursor.css';

// Build-time: see src/config/announcement.js to change the window.
const stripActive = isAnnouncementActive();

const {
  title,
  /** One sentence for search results and link previews. Every page sets it. */
  description = '',
  active = '',
  enquiryHref = 'contact.html',
  htmlClass,
  bodyClass = 'bg-page-bg text-body-text antialiased',
} = Astro.props;
---
<!doctype html>
<html lang="en" class={htmlClass} data-strip={stripActive ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    {/*
      Deliberately render-blocking, and measured both ways.
      Loading it asynchronously does cut the blocking time, but the text then
      paints in the fallback face and reflows when the webfont lands: mobile
      CLS went from 0.04 to 0.17 while LCP barely moved (2.45s -> 2.52s),
      because the LCP element is text that waits for the font either way.
      Blocking is the better trade here. Revisit by self-hosting the two
      families with size-adjust metrics, which removes the swap entirely.
    */}
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <ClientRouter />
    {stripActive && (
      <script is:inline define:vars={{ STORAGE_KEY }}>
        // Before first paint: if the strip was dismissed earlier, collapse the
        // whole header stack with no transition, so there is no flash of it.
        try {
          if (localStorage.getItem(STORAGE_KEY) === 'dismissed') {
            document.documentElement.classList.add('strip-dismissed');
          }
        } catch (e) { /* blocked storage: just show the strip */ }
      </script>
    )}
    <script is:inline>
      // Theme, before the first paint, so there is no flash of the wrong one.
      // An explicit choice in localStorage wins; otherwise follow the OS.
      // The rest of the behaviour lives in src/scripts/theme.js.
      try {
        var t = localStorage.getItem('unicore:theme');
        var dark = t === 'dark' || t === 'light'
          ? t === 'dark'
          : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
      } catch (e) { /* blocked storage: light, or whatever the OS says */ }
    </script>
    <script is:inline>
      // Curtain reveal: play it on the first page of a session only. The
      // curtain itself is pure CSS and opens with or without this script;
      // all this does is suppress a repeat. See CurtainReveal.astro.
      try {
        if (sessionStorage.getItem('unicore:curtain') === '1') {
          document.documentElement.classList.add('curtain-seen');
        } else {
          sessionStorage.setItem('unicore:curtain', '1');
        }
      } catch (e) { /* blocked storage: the curtain simply plays again */ }
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>

    {/* First thing in the tab order: lets a keyboard user jump the twelve
        header links straight to the page content. Visible only on focus. */}
    <a href="#main-content" class="skip-link">Skip to content</a>

    <CurtainReveal />

    <AnnouncementStrip />

    <Header active={active} enquiryHref={enquiryHref} />

    <MobileDrawer active={active} enquiryHref={enquiryHref} />

    <slot />

    <Footer active={active} />

    <script>
      import '../scripts/theme.js';
      import '../scripts/lang.js';
      import '../scripts/products-menu.js';
      import '../scripts/motion.js';
      import '../scripts/cursor.js';
      import '../scripts/accent-rotator.js';
    </script>
  </body>
</html>
