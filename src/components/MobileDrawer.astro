---
/**
 * Full-screen mobile menu, opened by the two-line button in Header.astro.
 * Exists once; rendered by Base.astro. Takes the same props as Header.astro.
 *
 * It is a navy sheet that opens as a circle growing from the button's corner,
 * then the links rise in one after another. The styles are in
 * src/styles/menu.css; the open/close state is the data-open attribute.
 */
const { active = '', enquiryHref = 'contact.html' } = Astro.props;

const items = [
  { key: 'home', label: 'Home', href: 'index.html' },
  { key: 'products', label: 'Products', href: 'products.html', sub: true },
  { key: 'tyre-sealant', label: 'Tyre Sealant', href: 'tyre-sealant.html' },
  { key: 'applications', label: 'Applications', href: 'applications.html' },
  { key: 'about', label: 'About', href: 'about.html' },
  { key: 'dealership', label: 'Dealership', href: 'dealership.html' },
  { key: 'contact', label: 'Contact', href: 'contact.html' },
];
const subs = [
  ['products-engine-oils', 'Engine Oils', 'products.html#engine-oils'],
  ['products-gear-oils', 'Gear Oils', 'products.html#gear-oils'],
  ['products-coolants', 'Coolants', 'products.html#coolants'],
  ['products-greases', 'Greases', 'products.html#greases'],
  ['products-agricultural-oils', 'Agricultural Oils', 'products.html#agricultural-oils'],
  ['products-industrial-hydraulic-oils', 'Industrial & Hydraulic Oils', 'products.html#industrial-hydraulic-oils'],
];
const num = (i) => String(i + 1).padStart(2, '0');
---
  <!-- MOBILE MENU DRAWER -->
  <div class="menu-drawer" id="mobile-menu-drawer" role="dialog" aria-modal="true" aria-label="Menu" tabindex="-1" data-open="false">
    <div class="menu-rings" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="menu-inner">
      <ol class="menu-list">
        {items.map((it, i) => (
          <li class="menu-item" style={`--i:${i}`}>
            {it.sub ? (
              <>
                <button class:list={['menu-link', 'menu-link-btn', active === it.key && 'is-active']} id="mobile-products-toggle" type="button">
                  <span class="menu-num">{num(i)}</span>
                  <span class="menu-text">{it.label}</span>
                  <span class="menu-arrow" id="mobile-products-arrow" aria-hidden="true">+</span>
                </button>
                <div class="menu-sub" id="mobile-products-menu" data-open="false">
                  <div class="menu-sub-inner">
                    {subs.map(([path, label, href]) => (
                      <a class="mobile-link menu-sub-link" data-path={path} href={href}>{label}</a>
                    ))}
                    <a class="mobile-link menu-sub-all" data-path="products" href="products.html">All products <span aria-hidden="true">→</span></a>
                  </div>
                </div>
              </>
            ) : (
              <a class:list={['mobile-link', 'menu-link', active === it.key && 'is-active']} data-path={it.key} href={it.href} aria-current={active === it.key ? 'page' : undefined}>
                <span class="menu-num">{num(i)}</span>
                <span class="menu-text">{it.label}</span>
                <span class="menu-arrow" aria-hidden="true">→</span>
              </a>
            )}
          </li>
        ))}
      </ol>
      <div class="menu-foot" style="--i:8">
        <a class="mobile-link menu-cta" data-path="enquiry" href={enquiryHref}>Enquiry Now <span aria-hidden="true">→</span></a>
        <p class="menu-tag">Industrial Lubricants · PAN India</p>
      </div>
    </div>
  </div>

<script>
  // Runs on first load and after every Astro view-transition navigation
  // (astro:page-load), because the DOM is swapped on navigation.
  function initDrawer() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    const productsToggle = document.getElementById('mobile-products-toggle');
    const productsMenu = document.getElementById('mobile-products-menu');
    if (!drawer || !toggleBtn) return;

    const FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';
    const isOpen = () => drawer.dataset.open === 'true';

    function setProducts(open) {
      if (!productsToggle || !productsMenu) return;
      productsMenu.dataset.open = open ? 'true' : 'false';
      productsToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      productsToggle.classList.toggle('is-open', open);
    }

    function setDrawer(open) {
      drawer.dataset.open = open ? 'true' : 'false';
      toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggleBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggleBtn.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      if (window.unicoreScrollLock) window.unicoreScrollLock(open);
      if (open) {
        // Move focus into the panel, otherwise a keyboard user opens the menu
        // and is still parked behind it in the page.
        drawer.focus({ preventScroll: true });
      } else {
        setProducts(false);
      }
    }

    if (productsToggle) {
      productsToggle.setAttribute('aria-controls', 'mobile-products-menu');
      setProducts(false);
      productsToggle.addEventListener('click', () => setProducts(productsMenu.dataset.open !== 'true'));
    }

    toggleBtn.addEventListener('click', () => setDrawer(!isOpen()));
    drawer.querySelectorAll('.mobile-link').forEach((link) => link.addEventListener('click', () => setDrawer(false)));

    // Escape closes it and hands focus back to the button that opened it.
    const onKey = (e) => {
      if (e.key === 'Escape' && isOpen()) {
        e.preventDefault();
        setDrawer(false);
        toggleBtn.focus();
      }
    };
    document.addEventListener('keydown', onKey);

    // Keep Tab inside the open menu.
    drawer.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !isOpen()) return;
      const items = [...drawer.querySelectorAll(FOCUSABLE)].filter((el) => el.offsetParent !== null);
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && (document.activeElement === first || document.activeElement === drawer)) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault(); first.focus();
      }
    });

    // Rotating the phone or widening the window past the burger breakpoint
    // while the menu is open must not leave the page locked.
    const mq = window.matchMedia('(min-width: 1280px)');
    const onMq = () => { if (mq.matches && isOpen()) setDrawer(false); };
    mq.addEventListener('change', onMq);

    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', onKey);
      mq.removeEventListener('change', onMq);
      document.body.style.overflow = '';
      document.documentElement.classList.remove('menu-open');
    }, { once: true });
  }
  document.addEventListener('astro:page-load', initDrawer);
</script>
