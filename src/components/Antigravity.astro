---
/**
 * Antigravity particle field — a WebGL2 canvas that fills its parent.
 *
 * Vanilla port of the React Bits component (see src/scripts/antigravity.js).
 * No React, no hydration directive, no extra dependency.
 *
 * Defaults are tuned for this site: brand blues only, low ambient and low
 * opacity so it reads as a faint engineered field rather than decoration.
 *
 * Two things keep it off the text:
 *   - a vertical mask, so the field is strongest at the top of the hero and
 *     gone before the body copy and the CTAs;
 *   - a separate, much lighter set of settings under 768px, where the hero is
 *     tall and narrow and the text fills the full width.
 *
 * It never runs under prefers-reduced-motion or <html data-motion="off">, and
 * the container is pointer-events:none so it cannot intercept clicks — the
 * engine tracks the pointer on `window` instead.
 *
 * TO REMOVE IT: delete the single <Antigravity /> line from the page.
 */

// Brand palette only (docs/DESIGN.md): logo-blue, deep-navy, light-text.
const DEFAULTS = {
  colors: ['#1B4FA0', '#143A78', '#737783'],
  count: 1100,
  magnetRadius: 9,
  ringRadius: 7,
  particleSize: 0.75,
  autoAnimate: true,
  colorMode: 'conic',
  colorSpeed: 0.04,
  particleShape: 'capsule',
  particleVariance: 1,
  fieldStrength: 10,
  waveAmplitude: 1,
  waveCount: 3,
  waveSpeed: 0.4,
  rotationSpeed: 0,
  pulseSpeed: 3,
  depthFactor: 1,
  ambient: 0.14,
  lerpSpeed: 0.05,
  interactive: true,
  clickBurst: true,
  intro: true,
  lightMode: true, // the site sits on #FAFAF8
  opacity: 0.5,
  maxDevicePixelRatio: 2,
};

/*
 * Below 1024px the field is switched OFF, deliberately.
 *
 * The cutoff is the `lg` breakpoint, not a phone width, because that is where
 * the hero stops being a two-column layout. The field needs the empty side
 * gutter next to the headline to live in; once the columns stack, the hero
 * goes tall and narrow (390x1051 on a phone, 900x1006 on a tablet) and the
 * text runs full width, so the field has nowhere to go. Measured on a phone,
 * the clean band above the eyebrow is only ~64px tall.
 *
 * Both honest options were tried and both were worse than nothing: full-bleed
 * made the headline hard to read, and masking it clear of the text made it
 * invisible while still running a 500-particle simulation every frame on the
 * devices least able to afford it.
 *
 * Stacked heroes are not bare — they keep the rotating headline, the grade
 * marquee and (in season) the toran.
 *
 * To run it below `lg` anyway, set `mobile` on the component and tune
 * MOBILE_DEFAULTS.
 */
const MOBILE_BREAKPOINT = '(max-width: 1023.98px)';
const MOBILE_DEFAULTS = {
  count: 420,
  particleSize: 0.6,
  ringRadius: 5,
  magnetRadius: 6.5,
  ambient: 0.1,
  opacity: 0.35,
  maxDevicePixelRatio: 1.75,
};

const {
  options = {},
  mobileOptions = {},
  /** Run on phones too. Off by default — see MOBILE_DEFAULTS above. */
  mobile = false,
  class: className = '',
  /** Where the field fades out, as a share of the container height. */
  fade = '58%',
} = Astro.props;

/*
 * Dark theme. The palette is baked into a GPU texture when the engine starts,
 * so it cannot simply be restyled — the field is destroyed and rebuilt when
 * the theme changes (see the script below).
 *
 * These are the dark values of the same three tokens the light field uses —
 * logo-blue, deep-navy and light-text — as defined in src/styles/global.css.
 * `lightMode` tells the shader it is now compositing on a dark canvas.
 */
const DARK_DEFAULTS = {
  colors: ['#7FA9F2', '#9DBDF5', '#969BA6'],
  lightMode: false,
  ambient: 0.11,
  opacity: 0.4,
};

const config = { ...DEFAULTS, ...options };
const mobileConfig = { ...config, ...MOBILE_DEFAULTS, ...mobileOptions };
const darkConfig = { ...config, ...DARK_DEFAULTS };
const mobileDarkConfig = { ...mobileConfig, ...DARK_DEFAULTS, ambient: 0.08, opacity: 0.3 };
---

<div
  class:list={['antigravity', className]}
  data-antigravity
  data-config={JSON.stringify(config)}
  data-dark-config={JSON.stringify(darkConfig)}
  data-mobile-config={mobile ? JSON.stringify(mobileConfig) : undefined}
  data-mobile-dark-config={mobile ? JSON.stringify(mobileDarkConfig) : undefined}
  style={`--ag-fade:${fade}`}
>
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .antigravity {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Decorative only: never swallow a click meant for the headline or a CTA.
       The engine reads pointer position from window, so this costs nothing. */
    pointer-events: none;
    /* Strongest at the top, gone by the body copy and the buttons. */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 var(--ag-fade, 58%), transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 var(--ag-fade, 58%), transparent 100%);
  }
  /* Off below the `lg` breakpoint unless the page opted in with `mobile`. */
  @media (max-width: 1023.98px) {
    .antigravity:not([data-mobile-config]) { display: none; }
  }
  .antigravity canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Motion rules (see PROJECT.md): off entirely, not merely slowed. */
  @media (prefers-reduced-motion: reduce) {
    .antigravity { display: none; }
  }
</style>

<script>
  /* The engine is pulled in with a dynamic import, not a static one. It is
     16 KB of WebGL that never runs below `lg` or under reduced motion, and a
     static import made every phone download and parse it anyway. Now the
     bundle is only fetched once we know the field is actually going to run. */
  let createAntigravity = null;

  const MOBILE = '(max-width: 1023.98px)'; // keep in step with the CSS above
  let instances = [];
  let mq = null;

  function motionOff() {
    return (
      document.documentElement.dataset.motion === 'off' ||
      (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)
    );
  }

  async function build() {
    if (motionOff()) return;
    const small = window.matchMedia(MOBILE).matches;
    const targets = [...document.querySelectorAll('[data-antigravity]')]
      .filter((el) => !small || el.dataset.mobileConfig);
    if (!targets.length) return;        // nothing to run: never fetch the engine

    if (!createAntigravity) {
      ({ createAntigravity } = await import('../scripts/antigravity.js'));
    }

    targets.forEach((el) => {
      const dark = document.documentElement.classList.contains('dark');
      const raw = small
        ? (dark ? el.dataset.mobileDarkConfig : el.dataset.mobileConfig)
        : (dark ? el.dataset.darkConfig : el.dataset.config);
      let config;
      try {
        config = JSON.parse(raw || '{}');
      } catch (e) {
        return;
      }
      instances.push(createAntigravity(el, config));
    });
  }

  function clear() {
    instances.forEach((instance) => instance.destroy());
    instances = [];
  }

  // Crossing the breakpoint swaps the whole settings object, so rebuild.
  function onBreakpoint() {
    clear();
    build();
  }

  // Same story for the theme: the palette is a GPU texture built at startup.
  function onThemeChange() {
    clear();
    build();
  }

  function initAntigravity() {
    teardownAntigravity();
    build();
    mq = window.matchMedia(MOBILE);
    mq.addEventListener('change', onBreakpoint);
    document.addEventListener('unicore:themechange', onThemeChange);
  }

  function teardownAntigravity() {
    clear();
    if (mq) mq.removeEventListener('change', onBreakpoint);
    mq = null;
    document.removeEventListener('unicore:themechange', onThemeChange);
  }

  document.addEventListener('astro:page-load', initAntigravity);
  document.addEventListener('astro:before-swap', teardownAntigravity);
</script>
