---
/**
 * Welcome intro, shown on every full page load and refresh. Moving between
 * pages by clicking a link does not replay it (see the script below).
 *
 * A navy layer: the UNICORE wordmark fills from the bottom like a tank
 * while a counter runs to 100, then the layer lifts away upward.
 *
 * HOW IT IS SAFE
 *   - It is a pure CSS animation with `both` fill, so it plays and finishes
 *     even if no JavaScript ever runs. It cannot get stuck over the site.
 *   - prefers-reduced-motion and <html data-motion="off"> hide it outright
 *     (display:none, see src/styles/motion.css) rather than freezing it shut.
 *
 * TO REMOVE IT: delete the CurtainReveal line in src/layouts/Base.astro. The CSS can stay or go with it.
 *
 * Timing and colours live in src/styles/motion.css under "Welcome intro".
 */
---
<div class="curtain" aria-hidden="true">
  <div class="curtain-sheet"></div>
  <div class="curtain-navy"></div>
  <div class="curtain-stage">
    <div class="curtain-mark">
      <span class="curtain-mark-outline">UNICORE</span>
      <span class="curtain-mark-fill">UNICORE</span>
    </div>
    <div class="curtain-line"></div>
    <div class="curtain-welcome">Welcome</div>
  </div>
  <span class="curtain-tag">Industrial Lubricants</span>
  <span class="curtain-count"></span>
</div>

<script>
  // A view transition swaps in the next document's <html>, which drops the
  // class the head script set — so the intro markup on the new page would
  // play again on every internal link. Put the class back before paint.
  document.addEventListener('astro:after-swap', () => {
    document.documentElement.classList.add('curtain-seen');
  });
</script>
