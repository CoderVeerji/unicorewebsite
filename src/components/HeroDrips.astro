---
/**
 * Golden oil drops hanging along the top of the homepage hero, as in the
 * client's reference banner. The Diwali diyas (HeroToran) take this place
 * during the festival window, so this renders only OUTSIDE it; the two never
 * show together. Positions come from a fixed seed, so every build is identical.
 */
import { isAnnouncementActive } from '../config/announcement.js';

const show = !isAnnouncementActive();

function rng(seed) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const drops = [];
const dots = [];
if (show) {
  const rand = rng(20260101);
  let x = 2;
  while (x < 98) {
    const big = rand() > 0.42;
    drops.push({
      left: +x.toFixed(2),
      size: big ? 18 + Math.round(rand() * 10) : 11 + Math.round(rand() * 5),
      thread: 4 + Math.round(rand() * (big ? 46 : 22)),
      delay: +(-(rand() * 6)).toFixed(2),
      dur: +(5.5 + rand() * 3).toFixed(2),
    });
    x += 5.5 + rand() * 7;
  }
  let dx = 1;
  while (dx < 99) {
    dots.push({ left: +dx.toFixed(2), top: 4 + Math.round(rand() * 8), size: 2 + Math.round(rand()) });
    dx += 1.6 + rand() * 3.2;
  }
}
---
{show && (
  <div class="hero-drips" aria-hidden="true">
    {dots.map((d) => <span class="hero-drip-dot" style={`left:${d.left}%;top:${d.top}px;width:${d.size}px;height:${d.size}px`}></span>)}
    {drops.map((d) => (
      <span class="hero-drip" style={`left:${d.left}%;--thread:${d.thread}px;--size:${d.size}px;animation-duration:${d.dur}s;animation-delay:${d.delay}s`}>
        <span class="hero-drip-drop"></span>
      </span>
    ))}
  </div>
)}
